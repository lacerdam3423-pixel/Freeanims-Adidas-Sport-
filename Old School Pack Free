-- Controle de aplicação em andamento (evita chamadas simultâneas)
local isApplying = false

-- Função principal
local function applyAnimations()
	-- 🔒 EVITA CHAMADAS SIMULTÂNEAS (não trava, só ignora)
	if isApplying then return end

	local char = lplr.Character
	if not char then return end

	local humanoid = char:FindFirstChild("Humanoid")
	local animate = char:FindFirstChild("Animate")

	if not humanoid or not animate then return end

	-- ==============================================
	-- 🕷️ VERIFICAÇÃO: SE FOR ARANHA/MONSTRO NÃO FAZ NADA 🕷️
	-- ==============================================
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")

	if not head or not torso or not leftLeg then return end

	-- ==============================================
	-- 🚫 REGRA: SE FOR R6, NÃO FAZ NADA, DEIXA NORMAL 🚫
	-- ==============================================
	if humanoid.RigType == Enum.HumanoidRigType.R6 then return end

	-- ==============================================
	-- ✅ VERIFICA SE PRECISA APLICAR ✅
	-- ==============================================
	local idle1 = animate:FindFirstChild("idle") and animate.idle:FindFirstChild("Animation1")
	if idle1 and idle1.AnimationId == oldschool.Idle1 then
		return -- Já está aplicado, sai sem travar nada
	end

	-- 🔒 Marca como aplicando
	isApplying = true

	-- PARA TODAS ANIMAÇÕES ANTES DE TROCAR (EVITA BUG)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in pairs(animator:GetPlayingAnimationTracks()) do
			track:Stop()
		end
	end

	animate.Enabled = false
	task.wait(0.02) -- Único yield necessário, mínimo possível

	-- COLOCA OS IDS CORRETOS PARA TODOS VEREM
	animate.idle.Animation1.AnimationId     = oldschool.Idle1
	animate.idle.Animation2.AnimationId     = oldschool.Idle2
	animate.walk.WalkAnim.AnimationId       = oldschool.Walk
	animate.run.RunAnim.AnimationId         = oldschool.Run
	animate.fall.FallAnim.AnimationId       = oldschool.Fall
	animate.jump.JumpAnim.AnimationId       = oldschool.Jump
	animate.climb.ClimbAnim.AnimationId     = oldschool.Climb
	animate.swim.Swim.AnimationId           = oldschool.Swim
	animate.swimidle.SwimIdle.AnimationId   = oldschool.SwimIdle

	animate.Enabled = true

	-- 🔓 Libera para próxima chamada
	isApplying = false
end

-- ==============================================
-- 🔄 LOOP PARA VOLTAR DEPOIS DA LADYBUG 🔄
-- ==============================================
task.spawn(function()
	while true do
		task.wait(0.011) -- 🔄 Loop rápido sem travar
		if lplr.Character then
			applyAnimations()
		end
	end
end)


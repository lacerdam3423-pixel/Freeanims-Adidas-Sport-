-- Função principal
local function applyAnimations()
	local char = lplr.Character
	if not char then return end
	
	local humanoid = char:FindFirstChild("Humanoid")
	local animate = char:FindFirstChild("Animate")
	
	if not humanoid or not animate then 
		return 
	end

	-- ==============================================
	-- 🕷️ VERIFICAÇÃO: SE FOR ARANHA/MONSTRO NÃO FAZ NADA 🕷️
	-- ==============================================
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
	
	if not head or not torso or not leftLeg then
		return
	end

	-- ==============================================
	-- 🚫 REGRA: SE FOR R6, NÃO FAZ NADA, DEIXA NORMAL 🚫
	-- ==============================================
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return
	end

	-- ==============================================
	-- ✅ VERIFICA SE PRECISA APLICAR ✅
	-- ==============================================
	if animate.idle.Animation1.AnimationId == adidas.Idle1 then
		return
	end

	animate.Enabled = false
	task.wait(0.05)

	-- COLOCA OS IDS CORRETOS PARA TODOS VEREM
	animate.idle.Animation1.AnimationId = adidas.Idle1
	animate.idle.Animation2.AnimationId = adidas.Idle2
	animate.walk.WalkAnim.AnimationId = adidas.Walk
	animate.run.RunAnim.AnimationId = adidas.Run
	animate.fall.FallAnim.AnimationId = adidas.Fall
	animate.jump.JumpAnim.AnimationId = adidas.Jump
	animate.climb.ClimbAnim.AnimationId = adidas.Climb
	animate.swim.Swim.AnimationId = adidas.Swim
	animate.swimidle.SwimIdle.AnimationId = adidas.SwimIdle

	animate.Enabled = true
end

-- ==============================================
	-- 🔄 LOOP PARA VOLTAR DEPOIS DA LADYBUG 🔄
-- ==============================================
spawn(function()
	while wait(3) do
		if lplr.Character then
			applyAnimations()
		end
	end
end)

-- Eventos
Btn.MouseButton1Click:Connect(applyAnimations)

lplr.CharacterAdded:Connect(function(newChar)
	character = newChar
	task.wait(1)
	applyAnimations()
end)

task.wait(0.5)
applyAnimations()

print("✅ Script Adidas Carregado!")

